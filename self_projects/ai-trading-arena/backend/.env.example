# Copy to .env and fill in.

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: shown on the OpenRouter dashboard for attribution
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=AI Trading Arena

# SQLite DB location (relative to backend/)
DATABASE_URL=sqlite:///./arena.db

# Starting paper-cash for every agent (USD)
STARTING_CASH=100000

# Comma-separated tickers the agents trade
TICKERS=AAPL,TSLA,SPY,NVDA,MSFT

# How often the loop runs while the market is open (minutes)
LOOP_INTERVAL_MINUTES=15

# Per-trade commission as a fraction of notional (e.g. 0.0005 = 5 bps). 0 = free.
COMMISSION_RATE=0.0

# Set to "true" to let the loop also run after-hours / weekends using the last
# available close (useful for demos so you don't have to wait for market open).
ALLOW_AFTER_HOURS=false
