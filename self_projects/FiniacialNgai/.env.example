# ── AI Providers (first set key wins: MiMo → Gemini → Ollama) ────────────────

# Xiaomi MiMo — primary provider (OpenAI-compatible)
# Get key at: https://platform.xiaomimimo.com
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
XIAOMI_MODEL=mimo-v2.5-pro

# Google Gemini — secondary provider
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter — optional (unused by default)
OPENROUTER_API_KEY=
